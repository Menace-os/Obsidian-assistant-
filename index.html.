
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OBSIDIAN — Personal AI</title>
<style>
:root {
  --bg:#070a12;
  --panel:#101725;
  --panel2:#151f30;
  --line:#26364c;
  --blue:#579cff;
  --cyan:#62d8ff;
  --text:#edf4ff;
  --muted:#8b9bb2;
  --green:#52d6a0;
}
* {box-sizing:border-box}
body {
  margin:0;
  background:radial-gradient(ellipse at 50% -20%,#152b4d 0%,var(--bg) 55%);
  color:var(--text);
  font-family:Inter,Arial,sans-serif;
  min-height:100vh;
}
button,input,textarea {font:inherit}
button {cursor:pointer}
.app {display:flex;min-height:100vh}
.sidebar {
  width:245px;background:#080d18;
  border-right:1px solid var(--line);
  padding:22px 15px;flex-shrink:0;
}
.logo {display:flex;align-items:center;gap:12px;margin-bottom:30px}
.logo-icon {
  width:43px;height:43px;border:2px solid var(--cyan);
  border-radius:50%;display:grid;place-items:center;
  color:var(--cyan);font-size:23px;
  box-shadow:0 0 22px #329dff55;
}
.logo h2 {font-size:17px;letter-spacing:4px;margin:0}
.logo small {color:var(--muted);font-size:9px;letter-spacing:2px}
.nav-label {
  color:#65758e;font-size:10px;letter-spacing:2px;
  margin:24px 10px 9px;
}
.nav {
  width:100%;border:0;background:transparent;color:#aebbd0;
  padding:12px 13px;border-radius:9px;text-align:left;
  margin:2px 0;display:flex;gap:12px;align-items:center;
}
.nav:hover,.nav.active {background:#192a43;color:white}
.nav.active {box-shadow:inset 3px 0 var(--blue)}
.status {
  margin-top:30px;padding:13px;border:1px solid var(--line);
  border-radius:12px;color:var(--muted);font-size:11px;
}
.dot {display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--green);margin-right:7px}
.main {flex:1;min-width:0;padding:25px 30px}
.topbar {display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:27px}
.topbar h1 {font-size:22px;margin:0}
.topbar p {font-size:12px;color:var(--muted);margin:5px 0}
.pill {border:1px solid var(--line);padding:9px 13px;border-radius:20px;font-size:11px;color:var(--cyan)}
.page {display:none}
.page.active {display:block}
.hero {
  background:linear-gradient(120deg,#142b4b,#101827 70%);
  border:1px solid #31527a;border-radius:17px;
  padding:25px;margin-bottom:20px;
  position:relative;overflow:hidden;
}
.hero:after {
  content:"";position:absolute;width:220px;height:220px;
  right:-70px;top:-100px;border:1px solid #62d8ff33;
  border-radius:50%;box-shadow:0 0 0 22px #62d8ff08,0 0 0 45px #62d8ff08;
}
.hero h2 {font-size:25px;margin:0 0 9px}
.hero p {color:#b8cbe5;font-size:13px;max-width:600px;line-height:1.6}
.primary {
  background:linear-gradient(100deg,#397fe7,#45b9ed);
  color:white;border:0;border-radius:9px;padding:12px 17px;
  font-weight:700;
}
.secondary {
  background:#1a2940;color:#dceaff;border:1px solid #344b69;
  border-radius:9px;padding:11px 15px;
}
.danger {background:#39202a;border-color:#693447;color:#ffb5c2}
.grid {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.card {
  background:linear-gradient(145deg,var(--panel2),var(--panel));
  border:1px solid var(--line);border-radius:13px;padding:18px;
  min-width:0;
}
.card h3 {font-size:14px;margin:0 0 9px}
.card p {font-size:12px;color:var(--muted);line-height:1.6;margin:0 0 12px}
.stat {font-size:25px;font-weight:700;color:var(--cyan)}
.mini {font-size:10px;color:var(--muted)}
.section-title {font-size:16px;margin:23px 0 13px}
.row {display:flex;align-items:center;justify-content:space-between;gap:12px}
.stack {display:flex;flex-direction:column;gap:12px}
input,textarea {
  width:100%;background:#080f1c;border:1px solid #30415b;
  border-radius:9px;color:white;padding:13px;outline:none;
}
input:focus,textarea:focus {border-color:var(--blue)}
textarea {min-height:100px;resize:vertical}
.chatbox {
  height:350px;overflow-y:auto;background:#080f1c;
  border:1px solid var(--line);border-radius:12px;
  padding:15px;margin-bottom:12px;
}
.message {padding:11px 13px;border-radius:10px;margin:9px 0;max-width:85%;font-size:13px;line-height:1.5}
.message.user {background:#1b3d68;margin-left:auto}
.message.ai {background:#172233;border:1px solid #2b3d55}
.message small {display:block;color:#8ca4c5;font-size:10px;margin-bottom:4px}
.task {
  padding:13px;background:#0c1421;border:1px solid var(--line);
  border-radius:10px;margin:9px 0;
}
.task strong {font-size:13px}
.task p {margin:6px 0;color:var(--muted);font-size:11px}
.tag {font-size:10px;color:var(--cyan);border:1px solid #315478;padding:4px 7px;border-radius:15px}
.agent {display:flex;align-items:center;gap:11px;padding:12px 0;border-bottom:1px solid var(--line)}
.agent-icon {width:34px;height:34px;border-radius:10px;background:#1d3657;display:grid;place-items:center}
.agent strong {font-size:12px}
.agent small {display:block;color:var(--muted);font-size:10px;margin-top:4px}
.toolbar {display:flex;gap:8px;flex-wrap:wrap}
.notice {
  border:1px solid #66552d;background:#292316;color:#e8d6a8;
  padding:12px;border-radius:9px;font-size:11px;line-height:1.5;
}
.list-item {padding:12px 0;border-bottom:1px solid var(--line);font-size:12px}
.list-item small {display:block;color:var(--muted);margin-top:5px}
.voice {
  position:fixed;bottom:18px;right:20px;
  border:1px solid #3b6d9f;background:#101d30;
  padding:12px 16px;border-radius:30px;color:white;
  box-shadow:0 0 25px #367bcb33;font-size:12px;
}
.bars {display:inline-flex;gap:3px;align-items:center;height:15px;margin-right:8px}
.bars i {width:3px;height:7px;background:var(--cyan);border-radius:4px;animation:pulse .8s infinite alternate}
.bars i:nth-child(2){animation-delay:.2s}
.bars i:nth-child(3){animation-delay:.4s}
@keyframes pulse {to{height:14px}}
@media(max-width:850px) {
 .sidebar{width:65px;padding:15px 7px}
 .logo h2,.logo small,.nav span,.nav-label,.status{display:none}
 .logo{justify-content:center}
 .nav{justify-content:center;padding:13px 4px}
 .main{padding:18px 13px}
 .grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:550px) {
 .grid{grid-template-columns:1fr}
 .topbar{align-items:flex-start;flex-direction:column}
 .hero h2{font-size:21px}
}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar">
  <div class="logo">
    <div class="logo-icon">O</div>
    <div><h2>OBSIDIAN</h2><small>INTELLIGENCE SYSTEM</small></div>
  </div>

  <div class="nav-label">MAIN SYSTEM</div>
  <button class="nav active" data-page="dashboard">◈ <span>Command Center</span></button>
  <button class="nav" data-page="assistant">✧ <span>AI Assistant</span></button>
  <button class="nav" data-page="autopilot">◎ <span>Autopilot</span></button>
  <button class="nav" data-page="operator">▣ <span>Computer Operator</span></button>
  <button class="nav" data-page="hive">⬡ <span>AI HIVE</span></button>

  <div class="nav-label">WORKSPACE</div>
  <button class="nav" data-page="school">▤ <span>School Center</span></button>
  <button class="nav" data-page="moderation">⚖ <span>Moderation Center</span></button>
  <button class="nav" data-page="messages">✉ <span>Messages</span></button>
  <button class="nav" data-page="research">⌕ <span>Research</span></button>
  <button class="nav" data-page="games">◇ <span>Game Center</span></button>
  <button class="nav" data-page="vault">▣ <span>Memory Vault</span></button>
  <button class="nav" data-page="activity">◷ <span>Activity Log</span></button>
  <button class="nav" data-page="settings">⚙ <span>Settings</span></button>

  <div class="status">
    <span class="dot"></span>Local workspace active
    <p>Demo environment · No live device connection</p>
  </div>
</aside>

<main class="main">
<header class="topbar">
  <div>
    <h1 id="pageTitle">Command Center</h1>
    <p>Your personal intelligence and execution workspace.</p>
  </div>
  <div class="pill">OBSIDIAN SYSTEM · DEMO</div>
</header>

<section class="page active" id="dashboard">
  <div class="hero">
    <h2>Good evening.</h2>
    <p>OBSIDIAN is ready. Give her a goal, and the system will organize the steps, coordinate its tools, and show you the results.</p>
    <button class="primary" onclick="go('autopilot')">Open Autopilot →</button>
  </div>
  <div class="grid">
    <div class="card"><h3>Active Tasks</h3><div class="stat" id="taskCount">0</div><p>Tasks in your local workspace.</p></div>
    <div class="card"><h3>AI Agents</h3><div class="stat">12</div><p>Specialized agents in the HIVE.</p></div>
    <div class="card"><h3>Saved Memories</h3><div class="stat" id="memoryCount">0</div><p>Notes saved in this browser.</p></div>
  </div>
  <h3 class="section-title">Quick commands</h3>
  <div class="grid">
    <div class="card"><h3>Take over my computer</h3><p>Open the operator workspace and request an authorized connection.</p><button class="secondary" onclick="go('operator')">Open Operator</button></div>
    <div class="card"><h3>Check my schoolwork</h3><p>Organize assignments and create a school task plan.</p><button class="secondary" onclick="go('school')">School Center</button></div>
    <div class="card"><h3>Help with Free Math School</h3><p>Review moderation cases and prepare staff communications.</p><button class="secondary" onclick="go('moderation')">Moderation Center</button></div>
  </div>
  <h3 class="section-title">Recent activity</h3>
  <div class="card" id="recentActivity"><p>No activity yet.</p></div>
</section>

<section class="page" id="assistant">
  <div class="card">
    <h3>OBSIDIAN AI</h3>
    <p>Talk naturally. Describe the result you want.</p>
    <div class="chatbox" id="chatbox">
      <div class="message ai"><small>OBSIDIAN</small>System initialized. What would you like me to work on?</div>
    </div>
    <div class="row">
      <input id="chatInput" placeholder="Tell OBSIDIAN what you need..." onkeydown="if(event.key==='Enter')sendChat()">
      <button class="primary" onclick="sendChat()">Send</button>
    </div>
  </div>
</section>

<section class="page" id="autopilot">
  <div class="hero">
    <h2>Autonomous Execution</h2>
    <p>Give OBSIDIAN an outcome. The task planner breaks it into steps and tracks progress.</p>
  </div>
  <div class="notice">This demo can plan and track tasks locally. Real AI reasoning, live website access, and computer operation require a connected backend and approved permissions.</div>
  <h3 class="section-title">Create a task</h3>
  <div class="card stack">
    <input id="taskInput" placeholder="Example: Organize my school assignments">
    <div class="toolbar">
      <button class="primary" onclick="createTask()">Start task</button>
      <button class="secondary" onclick="addExample()">Try example</button>
    </div>
  </div>
  <h3 class="section-title">Execution queue</h3>
  <div id="taskList" class="card"><p>No tasks yet. Give OBSIDIAN a goal.</p></div>
</section>

<section class="page" id="operator">
  <div class="hero">
    <h2>Computer Operator</h2>
    <p>Control supported applications and websites through approved integrations. This panel is where computer actions will be coordinated.</p>
  </div>
  <div class="notice">The current single-file demo cannot see your screen, click other apps, or control your Chromebook. Those features need a compatible extension or native app, a secure backend, and your permission.</div>
  <h3 class="section-title">Operator controls</h3>
  <div class="grid">
    <div class="card"><h3>Screen access</h3><p>Connect a supported screen-sharing integration.</p><button class="secondary" onclick="operatorRequest('Screen access requested')">Request access</button></div>
    <div class="card"><h3>Browser control</h3><p>Navigate approved websites through a browser integration.</p><button class="secondary" onclick="operatorRequest('Browser connection requested')">Connect browser</button></div>
    <div class="card"><h3>App control</h3><p>Open and interact with supported applications.</p><button class="secondary" onclick="operatorRequest('App connection requested')">Connect apps</button></div>
  </div>
  <h3 class="section-title">Command center</h3>
  <div class="card stack">
    <input id="operatorCommand" placeholder="Example: Open my school dashboard">
    <button class="primary" onclick="operatorCommand()">Submit command</button>
    <div id="operatorOutput" class="mini">No device connection active.</div>
  </div>
</section>

<section class="page" id="hive">
  <div class="hero"><h2>OBSIDIAN HIVE</h2><p>A coordinated team of specialized AI agents. Each agent handles a different kind of work.</p></div>
  <div class="card" id="agentList"></div>
</section>

<section class="page" id="school">
  <div class="hero"><h2>School Center</h2><p>Keep track of assignments, due dates, study sessions, and learning progress.</p></div>
  <div class="notice">Connect your school platform through an authorized integration. This demo does not log into school accounts or submit graded work.</div>
  <h3 class="section-title">Assignment organizer</h3>
  <div class="card stack">
    <input id="assignmentName" placeholder="Assignment name">
    <input id="assignmentDue" placeholder="Due date">
    <button class="primary" onclick="addAssignment()">Add assignment</button>
    <div id="assignmentList"></div>
  </div>
  <h3 class="section-title">Learning support</h3>
  <div class="grid">
    <div class="card"><h3>Math practice</h3><p>Work through practice problems and understand each step.</p><button class="secondary" onclick="go('assistant')">Open AI Assistant</button></div>
    <div class="card"><h3>Study planner</h3><p>Organize review sessions and upcoming work.</p><button class="secondary" onclick="createQuickTask('Create a study plan')">Create plan</button></div>
  </div>
</section>

<section class="page" id="moderation">
  <div class="hero"><h2>Free Math School</h2><p>Community operations, moderator support, staff workflows, and leadership development.</p></div>
  <div class="notice">OBSIDIAN can help review evidence and prepare decisions. It cannot reliably determine whether someone is lying from body language or text alone. A human moderator makes final enforcement decisions.</div>
  <h3 class="section-title">Moderation review</h3>
  <div class="card stack">
    <input id="caseTitle" placeholder="Case title or report ID">
    <textarea id="caseDetails" placeholder="Paste the relevant report, messages, and context..."></textarea>
    <button class="primary" onclick="reviewCase()">Review case</button>
    <div id="caseOutput"></div>
  </div>
  <h3 class="section-title">Staff operations</h3>
  <div class="grid">
    <div class="card"><h3>Staff chat</h3><p>Prepare clear, professional staff messages.</p><button class="secondary" onclick="go('messages')">Open Messages</button></div>
    <div class="card"><h3>Moderator chat</h3><p>Draft updates, announcements, and team responses.</p><button class="secondary" onclick="go('messages')">Open Messages</button></div>
    <div class="card"><h3>Leadership development</h3><p>Track responsibilities and prepare for Head Admin duties.</p><button class="secondary" onclick="createQuickTask('Create a Head Admin leadership development plan')">Build a plan</button></div>
  </div>
</section>

<section class="page" id="messages">
  <div class="hero"><h2>Communication Center</h2><p>Prepare natural messages for staff, moderators, and personal conversations.</p></div>
  <div class="notice">Messages are drafts in this demo. Review them before sending. Live inbox access and sending require an authorized messaging integration.</div>
  <div class="card stack">
    <input id="recipient" placeholder="Recipient or chat name">
    <textarea id="messageContext" placeholder="What happened? What do you want to say?"></textarea>
    <button class="primary" onclick="draftMessage()">Prepare reply</button>
    <div id="draftOutput"></div>
  </div>
</section>

<section class="page" id="research">
  <div class="hero"><h2>Research Intelligence</h2><p>Plan research, compare sources, and organize findings into useful reports.</p></div>
  <div class="card stack">
    <input id="researchTopic" placeholder="What should OBSIDIAN research?">
    <button class="primary" onclick="researchTask()">Create research task</button>
    <div id="researchOutput"></div>
  </div>
</section>

<section class="page" id="games">
  <div class="hero"><h2>Game Center</h2><p>Track regular game progress, achievements, quests, and gaming goals.</p></div>
  <div class="grid">
    <div class="card"><h3>Quest Tracker</h3><p>Record quests and track their completion.</p><button class="secondary" onclick="createQuickTask('Review my game quests and make a completion checklist')">Create quest checklist</button></div>
    <div class="card"><h3>Achievement Tracker</h3><p>Keep a list of achievements you want to unlock.</p><button class="secondary" onclick="createQuickTask('Create an achievement tracking plan')">Track achievements</button></div>
    <div class="card"><h3>Probability Lab</h3><p>Explore randomness and probability with non-wagering simulations.</p><button class="secondary" onclick="coinFlip()">Flip demo coin</button><div id="coinOutput" class="mini"></div></div>
  </div>
</section>

<section class="page" id="vault">
  <div class="hero"><h2>Memory Vault</h2><p>Save notes and information you want available in this browser.</p></div>
  <div class="card stack">
    <input id="noteTitle" placeholder="Note title">
    <textarea id="noteContent" placeholder="Write something to remember..."></textarea>
    <button class="primary" onclick="saveNote()">Save memory</button>
    <div id="notesList"></div>
  </div>
</section>

<section class="page" id="activity">
  <div class="hero"><h2>Activity Log</h2><p>See the actions recorded by this local demo.</p></div>
  <div class="card" id="activityList"></div>
</section>

<section class="page" id="settings">
  <div class="hero"><h2>System Settings</h2><p>Manage your local OBSIDIAN demo preferences.</p></div>
  <div class="card stack">
    <label><input type="checkbox" id="confirmActions" checked style="width:auto"> Require confirmation for sensitive actions</label>
    <label><input type="checkbox" id="voiceEnabled" style="width:auto"> Enable browser speech recognition when available</label>
    <button class="secondary" onclick="clearData()">Clear local demo data</button>
    <p class="mini">API keys must never be placed in this HTML file. Real AI services belong behind a secure backend.</p>
  </div>
</section>
</main>
</div>

<button class="voice" onclick="voiceCommand()"><span class="bars"><i></i><i></i><i></i></span>OBSIDIAN VOICE</button>

<script>
const $ = id => document.getElementById(id);
const read = key => JSON.parse(localStorage.getItem("obsidian_"+key) || "[]");
const write = (key,value) => localStorage.setItem("obsidian_"+key,JSON.stringify(value));

let tasks = read("tasks");
let notes = read("notes");
let assignments = read("assignments");
let activity = read("activity");

const titles = {
 dashboard:"Command Center",assistant:"AI Assistant",autopilot:"Autonomous Execution",
 operator:"Computer Operator",hive:"AI HIVE",school:"School Center",
 moderation:"Moderation Center",messages:"Communication Center",
 research:"Research Intelligence",games:"Game Center",vault:"Memory Vault",
 activity:"Activity Log",settings:"System Settings"
};

function go(page) {
 document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));
 document.querySelectorAll(".nav").forEach(n=>n.classList.remove("active"));
 $(page).classList.add("active");
 document.querySelector('[data-page="'+page+'"]').classList.add("active");
 $("pageTitle").textContent=titles[page];
}

document.querySelectorAll(".nav").forEach(btn=>{
 btn.addEventListener("click",()=>go(btn.dataset.page));
});

function log(message) {
 activity.unshift({message,time:new Date().toLocaleString()});
 activity=activity.slice(0,60);
 write("activity",activity);
 renderActivity();
 $("recentActivity").innerHTML=activity.length
  ? "<p>"+escapeHTML(activity[0].message)+"</p>"
  : "<p>No activity yet.</p>";
}

function escapeHTML(value) {
 return String(value).replace(/[&<>"']/g,c=>({
 "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
 }[c]));
}

function renderTasks() {
 $("taskCount").textContent=tasks.filter(t=>t.status!=="Completed").length;
 $("taskList").innerHTML=tasks.length?tasks.map((t,i)=>`
 <div class="task">
  <div class="row"><strong>${escapeHTML(t.title)}</strong><span class="tag">${t.status}</span></div>
  <p>${escapeHTML(t.detail)}</p>
  <div class="toolbar">
   <button class="secondary" onclick="advanceTask(${i})">Advance step</button>
   <button class="secondary danger" onclick="removeTask(${i})">Remove</button>
  </div>
 </div>`).join(""):"<p>No tasks yet.</p>";
}

function createTask() {
 const value=$("taskInput").value.trim();
 if(!value)return;
 tasks.unshift({
  title:value,status:"Planned",
  detail:"Task created. Review the steps and connect any required tools."
 });
 write("tasks",tasks);
 $("taskInput").value="";
 log("Created task: "+value);
 renderTasks();
}

function createQuickTask(name) {
 tasks.unshift({title:name,status:"Planned",detail:"A task plan has been created in the local demo."});
 write("tasks",tasks);
 log("Created task: "+name);
 renderTasks();
 go("autopilot");
}

function addExample() {
 $("taskInput").value="Review my school assignments and organize a study plan";
}

function advanceTask(i) {
 const stages=["Planned","In progress","Awaiting review","Completed"];
 let current=stages.indexOf(tasks[i].status);
 tasks[i].status=stages[Math.min(current+1,stages.length-1)];
 tasks[i].detail=tasks[i].status==="Completed"
  ?"Demo task marked complete. No external website action was performed."
  :"Demo status updated. Connect real integrations to perform external actions.";
 write("tasks",tasks);
 log("Updated task: "+tasks[i].title+" — "+tasks[i].status);
 renderTasks();
}

function removeTask(i) {
 tasks.splice(i,1);write("tasks",tasks);renderTasks();log("Removed a task");
}

function sendChat() {
 const value=$("chatInput").value.trim();
 if(!value)return;
 const box=$("chatbox");
 box.innerHTML+=`<div class="message user"><small>YOU</small>${escapeHTML(value)}</div>`;
 let response="I can help plan that task. Open Autopilot to create a task and track its steps. Live AI execution requires a connected AI backend.";
 if(/assignment|homework|school/i.test(value))response="I can help organize your schoolwork and work through practice problems. Open School Center to add assignments.";
 if(/moderator|staff|free math|admin/i.test(value))response="I can help review moderation context, prepare staff messages, and organize leadership tasks. Open Moderation Center.";
 if(/computer|take over|open/i.test(value))response="Open Computer Operator to request a supported connection. This demo cannot control your actual device yet.";
 box.innerHTML+=`<div class="message ai"><small>OBSIDIAN</small>${response}</div>`;
 $("chatInput").value="";
 box.scrollTop=box.scrollHeight;
 log("AI Assistant conversation");
}

function operatorRequest(message) {
 $("operatorOutput").textContent=message+". A real integration is not connected in this demo.";
 log(message);
}

function operatorCommand() {
 const value=$("operatorCommand").value.trim();
 if(!value)return;
 $("operatorOutput").textContent="Command received: "+value+". No live device connection is active.";
 log("Operator command requested: "+value);
}

const agents=[
 ["⌕","Research Agent","Research planning and source comparison"],
 ["⌘","Computer Agent","Supported computer workflows"],
 ["∑","Math Agent","Math explanations and practice"],
 ["▤","Education Agent","School planning and study support"],
 ["⚖","Moderation Agent","Reports, evidence, and fair review"],
 ["✉","Communication Agent","Message drafting and tone"],
 ["✎","Writing Agent","Documents and presentations"],
 ["◇","Game Agent","Quests and achievements"],
 ["▣","Memory Agent","Saved notes and retrieval"],
 ["⌁","Security Agent","Permissions and safety checks"],
 ["◈","Verification Agent","Check results and consistency"],
 ["⬡","Coordinator Agent","Break tasks into steps"]
];
$("agentList").innerHTML=agents.map(a=>`
 <div class="agent"><div class="agent-icon">${a[0]}</div>
 <div><strong>${a[1]}</strong><small>${a[2]}</small></div>
 <span class="tag" style="margin-left:auto">Available</span></div>`).join("");

function addAssignment() {
 const name=$("assignmentName").value.trim();
 const due=$("assignmentDue").value.trim();
 if(!name)return;
 assignments.unshift({name,due});
 write("assignments",assignments);
 $("assignmentName").value="";$("assignmentDue").value="";
 renderAssignments();log("Added assignment: "+name);
}

function renderAssignments() {
 $("assignmentList").innerHTML=assignments.map(a=>`
 <div class="list-item"><strong>${escapeHTML(a.name)}</strong>
 <small>Due: ${escapeHTML(a.due||"Not specified")}</small></div>`).join("")||"<p>No assignments added.</p>";
}

function reviewCase() {
 const title=$("caseTitle").value.trim();
 const details=$("caseDetails").value.trim();
 if(!details)return;
 $("caseOutput").innerHTML=`
 <div class="task"><strong>Review prepared: ${escapeHTML(title||"Untitled case")}</strong>
 <p>1. Identify the reported behavior.</p>
 <p>2. Separate direct evidence from assumptions.</p>
 <p>3. Review each person's account and relevant context.</p>
 <p>4. Check applicable community rules.</p>
 <p>5. Identify missing information and possible next steps.</p>
 <p><b>Human review required:</b> This demo does not determine guilt or issue moderation actions.</p></div>`;
 log("Prepared moderation review");
}

function draftMessage() {
 const recipient=$("recipient").value.trim();
 const context=$("messageContext").value.trim();
 if(!context)return;
 $("draftOutput").innerHTML=`
 <div class="task"><strong>Draft for ${escapeHTML(recipient||"recipient")}</strong>
 <textarea id="draftText">Hey, I wanted to follow up about this. ${escapeHTML(context)} I think we should look at the situation clearly and figure out the best next step.</textarea>
 <button class="secondary" onclick="copyDraft()">Copy draft</button></div>`;
 log("Prepared a message draft");
}

function copyDraft() {
 navigator.clipboard?.writeText($("draftText").value);
}

function researchTask() {
 const topic=$("researchTopic").value.trim();
 if(!topic)return;
 createQuickTask("Research: "+topic);
 $("researchOutput").textContent="Research task added. Live web research requires a connected search service.";
}

function coinFlip() {
 $("coinOutput").textContent=Math.random()<.5?"Result: Heads":"Result: Tails";
}

function saveNote() {
 const title=$("noteTitle").value.trim();
 const content=$("noteContent").value.trim();
 if(!content)return;
 notes.unshift({title:title||"Untitled note",content});
 write("notes",notes);
 $("noteTitle").value="";$("noteContent").value="";
 renderNotes();log("Saved a memory");
}

function renderNotes() {
 $("memoryCount").textContent=notes.length;
 $("notesList").innerHTML=notes.map((n,i)=>`
 <div class="list-item"><strong>${escapeHTML(n.title)}</strong>
 <small>${escapeHTML(n.content)}</small>
 <button class="secondary danger" onclick="deleteNote(${i})">Delete</button></div>`).join("")||"<p>No saved notes.</p>";
}

function deleteNote(i) {
 notes.splice(i,1);write("notes",notes);renderNotes();log("Deleted a memory");
}

function renderActivity() {
 $("activityList").innerHTML=activity.map(a=>`
 <div class="list-item">${escapeHTML(a.message)}<small>${escapeHTML(a.time)}</small></div>`).join("")||"<p>No recorded activity.</p>";
}

function clearData() {
 if(!confirm("Delete local OBSIDIAN demo data?"))return;
 ["tasks","notes","assignments","activity"].forEach(k=>localStorage.removeItem("obsidian_"+k));
 tasks=[];notes=[];assignments=[];activity=[];
 renderTasks();renderNotes();renderAssignments();renderActivity();
 log("Local demo data cleared");
}

function voiceCommand() {
 if(!$("voiceEnabled").checked) {
  alert("Enable browser speech recognition in Settings first.");
  return;
 }
 const Recognition=window.SpeechRecognition||window.webkitSpeechRecognition;
 if(!Recognition) {
  alert("Speech recognition is not supported by this browser.");
  return;
 }
 const recognition=new Recognition();
 recognition.lang="en-US";
 recognition.onresult=e=>{
  const command=e.results[0][0].transcript;
  go("assistant");
  $("chatInput").value=command;
  sendChat();
 };
 recognition.onerror=()=>alert("Voice recognition could not start.");
 recognition.start();
}

renderTasks();
renderNotes();
renderAssignments();
renderActivity();
</script>
</body>
</html>
